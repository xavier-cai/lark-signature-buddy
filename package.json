{
  "name": "lark-signature-buddy",
  "version": "1.0.0",
  "description": "A privacy-first Lark signature image slicer with a browser tool and companion bot.",
  "keywords": [
    "lark",
    "feishu",
    "signature",
    "image",
    "slicer"
  ],
  "homepage": "https://github.com/xavier-cai/lark-signature-buddy#readme",
  "bugs": {
    "url": "https://github.com/xavier-cai/lark-signature-buddy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xavier-cai/lark-signature-buddy.git"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "security:audit": "bash scripts/security-audit.sh --scope history",
    "security:audit:release": "bash scripts/security-audit.sh --scope release",
    "security:audit:remote": "bash scripts/audit-remote-refs.sh",
    "security:hooks": "bash scripts/install-hooks.sh",
    "security:install": "bash scripts/install-security-tools.sh",
    "start:bot": "node apps/bot/src/main.js",
    "test": "node --test tests/build.test.js tests/project.test.js tests/security-gate.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0"
  }
}
